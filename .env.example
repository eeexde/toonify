# live | mock
SOURCE_MODE=live
# Set to 1 to enable the ScraperGo (Toonily) manhwa source. Off by default:
# it mirrors a third-party site, so leave it off on public deploys.
SOURCE_SCRAPERGO=0
# Public URL of the deployment, used in the MangaDex User-Agent
APP_URL=http://localhost:3000
# Optional shared cache (recommended on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
